{
  "expo": {
    "name": "泥龙课表",
    "slug": "sicau-pocket",
    "version": "0.10.42",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sicau-pocket",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.grerat666708.sicaupocket",
      "infoPlist": {
        "CFBundleDisplayName": "泥龙课表",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "7",
      "appleTeamId": "HV6N28UTVZ",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.io.github.grerat666708.sicaupocket"
        ]
      }
    },
    "android": {
      "package": "io.github.grerat666708.sicaupocket",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#10864A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "versionCode": 52,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F4F7F3",
          "dark": {
            "backgroundColor": "#0E1411"
          }
        }
      ],
      "./plugins/withScheduleWidget",
      "./plugins/withProguardRules",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
